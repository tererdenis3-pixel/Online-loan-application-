<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apply</title>

    <script src="https://kit.fontawesome.com/b33e9054eb.js" crossorigin="anonymous"></script>

    <style>
    /* inlined from index.css */
    img{
        width: 100%;
        margin-top: 25%;
    }
    #online{
        margin-top: 50%;
        font-weight: bolder;
        font-size: 130%;
        text-align: center;
    }
    p{
        font-size: 120%;
        /* font-family:'charm'; */
        font-weight: bold;
        border-radius: 15px;
        width: 20%;
        margin-left: 35%;
        padding: 5%;
        background-color: rgb(28, 179, 190);
        text-align: center;
    }
    a:hover{
        background-color: rgb(235, 187, 27);
        color: black;
    }
    a{
        background-color: rgb(28, 179, 190);
        text-decoration: none;
        color: black;
    }
    </style>
</head>
<body>
    <div id="online">
        Online Loan Application
    </div>
    <div>
        <a href="./apply.html"><p id="apply">APPLY</p></a>
    </div>

    <script src="index.js"></script>
</body>
</html>